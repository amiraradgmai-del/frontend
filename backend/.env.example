TAX_AI_APP_NAME=Tax AI Advisor API
TAX_AI_APP_VERSION=0.1.0
TAX_AI_ENVIRONMENT=development
TAX_AI_LOG_LEVEL=INFO
TAX_AI_DOCS_ENABLED=true
TAX_AI_DATABASE_URL=postgresql+psycopg://tax_ai:change-me@localhost:5432/tax_ai
TAX_AI_READINESS_TIMEOUT_SECONDS=2
TAX_AI_JWT_SECRET=replace-with-at-least-32-random-characters
TAX_AI_ACCESS_TOKEN_MINUTES=15
TAX_AI_REFRESH_TOKEN_DAYS=30
TAX_AI_MAX_UPLOAD_BYTES=20971520
TAX_AI_STORAGE_BACKEND=local
TAX_AI_PUBLIC_SITE_URL=http://localhost:3000
TAX_AI_PAYMENT_PROVIDER=sandbox
TAX_AI_ZARINPAL_MERCHANT_ID=
TAX_AI_ZARINPAL_CALLBACK_URL=http://localhost:8000/api/v1/portal/payments/zarinpal/callback
TAX_AI_ZARINPAL_API_BASE_URL=https://payment.zarinpal.com/pg/v4/payment
TAX_AI_ZARINPAL_START_PAY_URL=https://payment.zarinpal.com/pg/StartPay
TAX_AI_LOCAL_STORAGE_PATH=./storage
TAX_AI_CELERY_BROKER_URL=redis://localhost:6379/0
TAX_AI_CELERY_RESULT_BACKEND=redis://localhost:6379/1
TAX_AI_TASK_EXECUTION_MODE=queue
TAX_AI_AI_PROVIDER=gemini
TAX_AI_GEMINI_API_KEY=
TAX_AI_GEMINI_GENERATION_MODEL=gemini-2.5-flash
TAX_AI_GEMINI_GENERAL_MODEL=gemini-2.5-flash-lite
TAX_AI_GEMINI_ADVANCED_MODEL=gemini-3.5-flash
TAX_AI_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
TAX_AI_GEMINI_TIMEOUT_SECONDS=20
TAX_AI_EMBEDDING_DIMENSIONS=768
TAX_AI_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TAX_AI_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
TAX_AI_BOOTSTRAP_ADMIN_FULL_NAME=System Admin
TAX_AI_EMAIL_DELIVERY_MODE=console
TAX_AI_SMTP_HOST=smtp.gmail.com
TAX_AI_SMTP_PORT=587
TAX_AI_SMTP_USERNAME=
TAX_AI_SMTP_PASSWORD=
TAX_AI_SMTP_FROM_EMAIL=
TAX_AI_SMTP_FROM_NAME=Tax AI Advisor
TAX_AI_SMTP_USE_TLS=true
TAX_AI_MELIPAYAMAK_USERNAME=
TAX_AI_MELIPAYAMAK_API_KEY=
